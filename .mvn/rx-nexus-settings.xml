<?xml version="1.0" encoding="UTF-8"?>
<!--
	RxLogix Nexus: configured from the environment so no credentials live in the repo
	(same NEXUS_* variables as the spring-framework, spring-security, spring-cloud-commons
	and spring-data-jpa forks).

	Pass it as *global* settings so ~/.m2/settings.xml (mirrors, servers) still applies.
	Build first, then deploy only the modules upstream publishes to Maven Central
	(the root pom is not published there; the flattened module poms do not reference it):

	./mvnw -gs .mvn/rx-nexus-settings.xml install -DskipTests
	./mvnw -gs .mvn/rx-nexus-settings.xml deploy -DskipTests \
		-pl spring-batch-infrastructure,spring-batch-core,spring-batch-test,spring-batch-integration,spring-batch-bom

	Releases (5.2.6-rxlogix-N) go to NEXUS_URL; -SNAPSHOT versions follow
	the project's own snapshot repository unless overridden on the command line.
-->
<settings>
	<servers>
		<server>
			<id>rx-nexus</id>
			<username>${env.NEXUS_USERNAME}</username>
			<password>${env.NEXUS_PASSWORD}</password>
		</server>
	</servers>
	<profiles>
		<profile>
			<id>rx-nexus</id>
			<properties>
				<!-- id::layout::url form is understood by every maven-deploy-plugin version
					(2.x only knows altDeploymentRepository; 3.x prefers altReleaseDeploymentRepository) -->
				<altDeploymentRepository>rx-nexus::default::${env.NEXUS_URL}</altDeploymentRepository>
				<altReleaseDeploymentRepository>rx-nexus::default::${env.NEXUS_URL}</altReleaseDeploymentRepository>
			</properties>
		</profile>
	</profiles>
	<activeProfiles>
		<activeProfile>rx-nexus</activeProfile>
	</activeProfiles>
</settings>
